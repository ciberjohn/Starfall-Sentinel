; GRAVES meteor-scatter detector configuration.
; Copy to config.ini and edit. Explicit CLI flags override these values.
; This file is gitignored - your real values (station name, webhook,
; coordinates) never get committed.

[detector]
frequency = 143.050M
sample_rate = 48000
gain = 40
ppm = 0
threshold_db = 10.0
min_ms = 80.0
max_ms = 8000.0
noise_history_s = 25.0
floor_percentile = 10.0
window_ms = 50.0
log = data/pings.csv
live_out = data/live.csv
; Live samples are trimmed to the last N hours every 30 min (0 = never trim).
live_max_hours = 12.0
name = my-station-1

; Optional: Discord webhook for ping alerts (create a channel webhook first).
; webhook = https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy
; webhook_long = false

; Per-ping waveform capture: the detector keeps a ~20 Hz ring buffer and
; saves one small curve CSV per event (t_ms,db,floor) to data/ping_curves.
; Event end: a fading echo ends only when the level stays below
; floor+end_margin_db for hangover_windows consecutive windows - so one
; overdense echo fluctuating across the threshold is not split into many
; pings. Defaults: end_margin_db = 3.0, hangover_windows = 10 (500 ms at
; 20 Hz).
; curve_dir = data/ping_curves
; curve_pre_s = 1.0
; curve_post_s = 1.0
; end_margin_db = 3.0
; hangover_windows = 10
; Curve capture rate (Hz), decoupled from the detection windows: 100 Hz =
; 10 ms resolution echo shapes; 0 = same rate as detection (~20 Hz).
; curve_hz = 100
; Curves stay live for 6 months, then move to monthly .tar.gz archives
; (data/ping_curves_archive/) kept for 2 years total - consult old shapes
; with: tar -xzf ping_curves_2026-08.tar.gz
; curve_retention_days = 182
; curve_archive_days = 730
; curve_archive_dir = data/ping_curves_archive

[sstv]
; ISS SSTV decoding (iss_sstv_decode.py). Defaults mirror the [detector]
; paths; only override if you keep data elsewhere.
; clips_dir = data/iss_clips
; out_dir = data/iss_sstv

[email]
; Used by imo_report.py (citizen-science submissions). Same Gmail app
; password as Uhura's comm station - gitignored, never commit.
; smtp_host = smtp.gmail.com
; smtp_port = 587
; user =
; password =

[imo]
; Recipient + observer identity for the IMO-style echo-count report.
; Verified recipient (2026-08-04): IMO Radio Commission Director Christian
; Steyaert - radio@imo.net. Daily cron is PAUSED until the format is agreed.
; to =
; observer = your-name
; station_name = Starfall Sentinel

[station]
; Used only locally by dashboard.py to compute the bearing/distance shown
; in the compass quadrant - run `python3 bearing.py --from "lat,lon"` to get
; your own numbers first. Never sent anywhere, and the dashboard rounds the
; displayed bearing/distance to the nearest 5 degrees / 100 km regardless,
; so a public stream can't be used to reverse-geolocate your station.
lat = 0.0
lon = 0.0
; Freeform text shown in the dashboard header - keep it region-level only
; (e.g. "Example Region, Country", "Ontario, Canada") if this page will ever be
; public or streamed. Never a postcode/zip or house-level detail.
region = set your region here

; Target radar/beacon to compute bearing toward. Defaults to GRAVES, the
; main subject of this whole project - only change these if you're aiming
; at a different beacon (see bearing.py --target for other known targets).
target_name = GRAVES radar
target_lat = 47.351
target_lon = 5.515

[iss]
; graves-iss.service pauses graves-watch and retunes the dongle to catch
; the ISS whenever a pass clears this elevation - see satpass.py and
; iss_scheduler.py. Kept high on purpose: this is the only lever that
; trades away meteor coverage, so it only fires for passes with a real
; chance of a usable catch, not every marginal horizon-skimmer.
min_elevation = 40.0
; ISS APRS digipeater - the most consistently-active ISS ham frequency, so
; it's the best single-channel bet for actually catching something. Switch
; to 145.800M for voice/SSTV if you'd rather gamble on a scheduled ARISS
; contact or SSTV event lining up with a pass.
frequency = 145.825M
gain = 40
ppm = 0
; FM's idle-vs-signal margin is a few dB, not GRAVES' 10+ (raw FM
; demodulation is loud on pure noise, not silent - see iss_recorder.py's
; docstring). Run `iss_recorder.py --calibrate` during a real pass to retune.
threshold_db = 4.0
min_ms = 150.0
hangover_windows = 3
preroll_s = 0.5
clip_max_s = 45.0
; Scheduler-only: margin around AOS/LOS (start a bit early, keep listening a
; bit late) and how often to re-poll when no qualifying pass is upcoming.
pass_preroll_s = 20.0
pass_postroll_s = 20.0
recheck_interval_s = 1800.0
device_cooldown_s = 2.5
hits_log = data/iss_hits.csv
clips_dir = data/iss_clips
