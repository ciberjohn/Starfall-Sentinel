; GRAVES meteor-scatter detector configuration.
; Copy to config.ini and edit. Explicit CLI flags override these values.
; This file is gitignored - your real values (station name, webhook,
; coordinates) never get committed.

[detector]
frequency = 143.050M
sample_rate = 48000
gain = 40
ppm = 0
threshold_db = 10.0
min_ms = 80.0
max_ms = 8000.0
noise_history_s = 25.0
floor_percentile = 10.0
window_ms = 50.0
log = data/pings.csv
live_out = data/live.csv
name = my-station-1

; Optional: Discord webhook for ping alerts (create a channel webhook first).
; webhook = https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy
; webhook_long = false

[station]
; Used only locally by dashboard.py to compute the bearing/distance shown
; in the compass quadrant - run `python3 bearing.py --from "lat,lon"` to get
; your own numbers first. Never sent anywhere, and the dashboard rounds the
; displayed bearing/distance to the nearest 5 degrees / 100 km regardless,
; so a public stream can't be used to reverse-geolocate your station.
lat = 0.0
lon = 0.0
; Freeform text shown in the dashboard header - keep it region-level only
; (e.g. "Pacific Northwest, USA", "Bavaria, Germany") if this page will ever be
; public or streamed. Never a postcode/zip or house-level detail.
region = set your region here

; Target radar/beacon to compute bearing toward. Defaults to GRAVES, the
; main subject of this whole project - only change these if you're aiming
; at a different beacon (see bearing.py --target for other known targets).
target_name = GRAVES radar
target_lat = 47.351
target_lon = 5.515
