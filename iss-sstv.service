[Unit]
Description=Starfall Sentinel — decode ISS SSTV clips into images
After=graves-iss.service

[Service]
Type=oneshot
WorkingDirectory=/home/YOUR_USERNAME/Starfall-Sentinel
ExecStart=/usr/bin/python3 /home/YOUR_USERNAME/Starfall-Sentinel/iss_sstv_decode.py --config /home/YOUR_USERNAME/Starfall-Sentinel/config.ini
